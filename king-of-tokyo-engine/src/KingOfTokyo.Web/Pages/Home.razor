@page "/"

<section class="hero">
    <div class="card">
        <p class="status-pill">Play locally with friends</p>
        <h1>Become the King of Tokyo</h1>
        <p class="muted">
            Create a lobby, share its link, and play a match from separate browser profiles.
        </p>
        <div class="actions">
            <NavLink class="btn btn-primary" href="lobbies/new">Create lobby</NavLink>
        </div>
    </div>

    <div class="panel">
        <h2>How to play</h2>
        <ul class="muted">
            <li>Create a lobby and copy its invite link.</li>
            <li>Join from another browser profile or private window and mark the guest ready.</li>
            <li>Start the match as host, then follow the next action on each player's game table.</li>
        </ul>
    </div>
</section>

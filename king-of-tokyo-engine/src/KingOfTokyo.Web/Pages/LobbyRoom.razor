@page "/lobbies/{LobbyId:guid}"
@implements IDisposable
@inject ApiClient ApiClient
@inject ClientSessionState Session
@inject NavigationManager Navigation

<div class="card lobby-hero">
    <p class="status-pill">Monster staging area</p>
    <h1>Lobby</h1>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <p class="status-pill danger-pill">@_error</p>
    }

    @if (_lobby is null)
    {
        <p class="muted">Loading lobby...</p>
    }
    else
    {
        <div class="grid-2">
            <section>
                <h2>@_lobby.Name</h2>
                <p class="muted">Lobby id: <code>@_lobby.LobbyId</code></p>
                <p>Status: <span class="status-pill">@_lobby.Status</span></p>
                <p class="muted">
                    Max players: @_lobby.MaxPlayers<br />
                    Initial health: @_lobby.InitialHealth<br />
                    Target VP/XP: @_lobby.TargetVictoryPoints<br />
                    Visibility: @(_lobby.IsPublic ? "Public" : "Private")
                </p>
                <div class="field">
                    <label for="lobby-link">Invite link</label>
                    <input id="lobby-link" value="@LobbyUrl" readonly aria-label="Invite link" />
                    <small class="muted">Copy this link and open it in another browser profile or private window.</small>
                </div>
            </section>

            @if ((_lobby.Status is "WaitingForPlayers" or "ReadyToStart") && _currentSeat is null)
            {
            <section class="panel">
                <h2>Join this lobby</h2>
                <p class="muted">Each player needs a separate browser profile or private window.</p>
                <div class="field">
                    <label for="join-name">Your display name</label>
                    <InputText id="join-name" @bind-Value="_joinName" />
                </div>
                <div class="field">
                    <label for="join-monster">Your monster</label>
                    <InputSelect id="join-monster" @bind-Value="_joinMonsterId" @onchange="OnJoinMonsterChanged">
                        @foreach (var monster in MonsterCatalog.Monsters)
                        {
                            <option value="@monster.MonsterId">@monster.Emoji @monster.MonsterName</option>
                        }
                    </InputSelect>
                </div>
                <div class="actions">
                    <button class="btn btn-secondary" @onclick="JoinAsync" disabled="@_busy">Join</button>
                    <button class="btn btn-secondary" @onclick="RefreshAsync" disabled="@_busy">Refresh</button>
                </div>
            </section>
            }
            else
            {
                <section class="panel">
                    <h2>@(_lobby.GameId is null ? "Waiting for players" : "Game ready")</h2>
                    <p class="muted">@(_lobby.GameId is null ? "When everyone is ready, the host can start the game." : "Open the game from your own browser window.")</p>
                </section>
            }
        </div>

        <section class="panel">
            <h2>Choose your destroyers</h2>
            <div class="monster-grid">
                @foreach (var seat in _lobby.Seats)
                {
                    var monster = MonsterCatalog.Find(seat.MonsterId);
                    <article class="monster-card display-card" style="--accent:@monster.Accent">
                        <span class="monster-emoji">@monster.Emoji</span>
                        <strong>@seat.MonsterName</strong>
                        <small>@seat.DisplayName • Player #@seat.PlayerId</small>
                        <div class="actions compact-actions">
                            @if (seat.IsHost)
                            {
                                <span class="status-pill">Host</span>
                            }
                            <span class="status-pill">@(seat.IsReady ? "Ready" : "Not ready")</span>
                            @if (Session.LobbyId == LobbyId && Session.PlayerId == seat.PlayerId)
                            {
                                <span class="status-pill">You</span>
                            }
                        </div>
                    </article>
                }
            </div>
        </section>

        <div class="actions">
            <button class="btn btn-primary" @onclick="ToggleReadyAsync" disabled="@(!_canToggleReady || _busy)">
                @(_currentSeat?.IsReady == true ? "Set not ready" : "Set ready")
            </button>
            <button class="btn btn-primary" @onclick="StartAsync" disabled="@(!_canStart || _busy)">Start game</button>
            @if (_lobby.GameId is not null)
            {
                <NavLink class="btn btn-secondary" href="@($"games/{_lobby.GameId}")">Open game</NavLink>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid LobbyId { get; set; }

    private LobbyDto? _lobby;
    private LobbySeatDto? _currentSeat;
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;
    private bool _busy;
    private string? _error;
    private string _joinName = "Guest";
    private string _joinMonsterId = MonsterCatalog.Default.MonsterId;
    private MonsterOption _joinMonster = MonsterCatalog.Default;
    private string LobbyUrl => Navigation.ToAbsoluteUri($"/lobbies/{LobbyId}").ToString();
    private bool _canToggleReady => _lobby is not null && Session.PlayerToken is not null && _currentSeat is not null && _lobby.Status is "WaitingForPlayers" or "ReadyToStart";
    private bool _canStart => _lobby?.Status == "ReadyToStart" && _currentSeat?.IsHost == true && Session.PlayerToken is not null;

    protected override async Task OnInitializedAsync()
    {
        await Session.LoadAsync();
        await RefreshAsync();
        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        _ = PollAsync(_cts.Token);
    }

    private void OnJoinMonsterChanged(ChangeEventArgs args)
    {
        _joinMonsterId = args.Value?.ToString() ?? MonsterCatalog.Default.MonsterId;
        _joinMonster = MonsterCatalog.Find(_joinMonsterId);
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (_timer is not null && await _timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(RefreshAsync);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RefreshAsync()
    {
        try
        {
            _lobby = await ApiClient.GetLobbyAsync(LobbyId);
            _error = null;
            _currentSeat = Session.LobbyId == LobbyId ? _lobby?.Seats.FirstOrDefault(seat => seat.PlayerId == Session.PlayerId) : null;

            if (_lobby?.GameId is not null && Session.GameId != _lobby.GameId.Value)
            {
                Session.RememberGame(_lobby.GameId.Value);
                await Session.SaveAsync();
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task JoinAsync()
    {
        _busy = true;
        _error = null;

        try
        {
            var result = await ApiClient.JoinLobbyAsync(LobbyId, new JoinLobbyRequest(
                _joinName,
                _joinMonster.MonsterId,
                _joinMonster.MonsterName,
                _joinMonster.AvatarId));
            Session.RememberLobby(LobbyId, result.PlayerId, result.PlayerToken);
            await Session.SaveAsync();
            _lobby = result.Lobby;
            _currentSeat = result.Lobby.Seats.FirstOrDefault(seat => seat.PlayerId == result.PlayerId);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleReadyAsync()
    {
        if (Session.PlayerToken is null || _currentSeat is null)
        {
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            _lobby = await ApiClient.SetReadyAsync(LobbyId, new SetLobbyReadyRequest(Session.PlayerToken.Value, !_currentSeat.IsReady));
            _currentSeat = _lobby.Seats.FirstOrDefault(seat => seat.PlayerId == Session.PlayerId);
            await Session.SaveAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task StartAsync()
    {
        if (Session.PlayerToken is null)
        {
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            var result = await ApiClient.StartLobbyAsync(LobbyId, new StartLobbyRequest(Session.PlayerToken.Value));
            Session.RememberGame(result.Game.GameId);
            await Session.SaveAsync();
            Navigation.NavigateTo($"/games/{result.Game.GameId}");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _timer?.Dispose();
    }
}
